# Copy this file to .env and fill in values
# .env is gitignored and must never be committed

# Elexon BMRS API base URL (public, no auth required currently)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Allowed CORS origins (comma-separated). Use * for dev, restrict in prod.
# Example: https://kjhwr-frontend.onrender.com
ALLOWED_ORIGINS=*
